[Unit]
Description=Kyutai Pocket TTS server for Omarchy Assistant
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Language: english, french_24l, german_24l, italian, spanish, portuguese
ExecStart=%h/.local/share/assistant-tts-pocket/bin/pocket-tts serve --port 8765 --language english
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target