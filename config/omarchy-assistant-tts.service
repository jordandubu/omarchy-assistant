[Unit]
Description=Kyutai Pocket TTS server for Omarchy Assistant
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Language must match settings.json "language" (en, fr, de, it, es, pt)
ExecStart=%h/.local/share/assistant-tts-pocket/bin/pocket-tts serve --port 8765 --language en
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target